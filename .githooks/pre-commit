#!/bin/sh
# Fast and advisory. The blocking gate is pre-push.
.venv/bin/python model/validation/index.py --check || true
# A registered id missing from the golden renders not_evaluated in the product
# and turns the push gate red; this says so at commit time, in seconds.
.venv/bin/python model/validation/api.py --ids || true
# 2026-09-12. Early warning for the ratchet pre-push enforces: a new bare sigil.
.venv/bin/python model/validation/bare_markers.py || true
# Calibration touched: its self-checks and golden round-trip, advisory; pre-push blocks.
git diff --cached --name-only | grep -qE '^(model/engine/(autocal|calibrators|pitch|sceneprior)\.py|app/server/jobs\.py)' &&
  { .venv/bin/python model/validation/check.py calib --fast || true; }
git diff --cached --name-only | grep -qE '^model/engine/(track|tracking|stitch)\.py' &&
  { .venv/bin/python model/validation/check.py track --fast || true; }
git diff --cached --name-only | grep -qE '^(model/engine/(detectors|coreml_worker)\.py|app/server/requirements\.txt)' &&
  { .venv/bin/python model/validation/check.py detect --fast || true; }
git diff --cached --name-only | grep -qE '^(model/engine/(identity|roster)\.py|app/server/jobs\.py)' &&
  { .venv/bin/python model/validation/check.py identity --fast || true; }
git diff --cached --name-only | grep -qE '^(model/engine/(stats|frames|roles|quality|calibrators|test_golden|identity|roster|track|tracking|stitch)\.py|app/server/jobs\.py|model/validation/(check\.py|golden\.json)|model/validation/fixtures/(measure|identity|track)/)' &&
  { .venv/bin/python model/validation/check.py measure --fast || true; }
git diff --cached --name-only | grep -qE '^(model/engine/(ball|track|detectors)\.py|model/validation/fixtures/ball/)' &&
  { .venv/bin/python model/validation/check.py ball --fast || true; }
exec .venv/bin/python model/validation/lint_truth.py
