# Environments. Both spellings: a trailing slash matches a directory and never a
# symlink at the same path, so `.venv/` alone would let a linked venv be committed.
.venv
.venv/
venv
venv/
env
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Runtime state written by the dev launcher (pids, tailed logs).
/.run/

# OS / editor / local tools
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.claude/
.obsidian/

# Pipeline outputs written at the repo root. Leading slash: root copies only,
# never a committed fixture with the same name. tracks.json is ~57 MB per half.
/tracks.json
/tracks.json.tmp
/calibration.json
/season.json
/serve_selfcheck.bin
.serve_selfcheck.bin

# The job store. jobs.py writes UPLOADED USER VIDEO into data/jobs/<id>/, so all of
# data/ is ignored except the READMEs and the vendored code below. `/data/*`, not
# `/data/`: git cannot re-include anything under an excluded directory.
/data/*
!/data/footage/
/data/footage/*
!/data/footage/README.md
!/data/footage/soccertrack/
/data/footage/soccertrack/*
!/data/footage/soccertrack/README.md
# TeamTrack's zip member table and the fetch record: `ball_clean.py fetch` needs the first
!/data/footage/soccertrack/teamtrack_zip_index.json
!/data/footage/soccertrack/teamtrack_fetch.json
!/data/vendor/
/data/vendor/*
# ssac26 is vendored: 12 KB of BSD-3 code plus the fixture vision_eval.py measures on.
!/data/vendor/ssac26/
data/renders/

# Source footage never belongs in git...
*.mp4
*.mov
*.mkv
*.avi
# ...except the 20-frame excerpt `check.py detect` runs on (1.4 MB).
!model/validation/fixtures/detect/*.mp4

# Ground-truth caches (~4.6 MB each, rebuilt by `validate.py --cache`), except the
# one test_golden.py needs - without it that test skips and reports success.
model/validation/soccertrack/*.gz
!model/validation/soccertrack/118575_1st.tracks.json.gz

# Models and training data: rebuilt or downloaded, never committed.
/model/models
/model/models/
/models
/validation/
/model/validation/role_data
/model/validation/role_data/
/model/validation/role_crops.npz
/model/validation/tune_runs/

# Experiment outputs are scratch, except the small result files a cited number
# reads - a claim whose input is on one machine cannot be re-run. Directories are
# re-included level by level because git cannot re-include under an excluded one.
